ound-color: #1e73be;	border-color: #1e73be;	}	.bottom_foooter {	border-top: solid 5px #1e73be !important;;	}	.singlePost p a {	border: none;	display: inline;	}	.thumb_img img {	height: 284px !important;	object-fit: cover;	object-position: left;	}	.w3eden a, .w3eden a:hover { color:#000; }	.templates_list h2{ font-size: 1.25rem; }	.bottom_foooter .nav .nav-item a{ padding: .0rem 0.5rem; border-right: 1px #ccc solid; font-size: 1rem; }	.bottom_foooter .nav .nav-item:last-child a { border-right: none; }	.d_sidebar ul li{ font-size: 1rem; }	.singlePost p a{ padding:0; font-weight:normal; text-decoration:underline; }	.h3, h3 { font-size: 1.5rem;}	.btn-primary { background:#1e73be !important; color: #fff !important; }	.d_sidebar:first-of-type h6.sidebar_head{	background-image: linear-gradient(45deg, #c00000, #ff3334) !important;	}	.d_sidebar:first-of-type{ border-color: #c00000 !important; }	.oto_toc ul li { margin: 3px 0; } .breadcrumbs, .breadcrumbs a{ font-size: 0.85em; }	.singlePost ul:not(.list-group), .page ul:not(.list-group) { list-style-type: none; padding-left: 20px;	}	.singlePost ol li, .page ol li{ margin-bottom:16px; }	.singlePost li:not(.page-item, .cat-item, .textwidget li, .d_sidebar li, .menu-item), .page li:not(.page-item, .cat-item, .textwidget li, .d_sidebar li, .menu-item){ position: relative; padding-left: 30px; }	.singlePost ul li:not(.page-item, .cat-item, .cat-item, .textwidget li, .d_sidebar li, .menu-item, .list-group-item, .nav-item)::before,	.page ul li:not(.page-item, .cat-item, .textwidget li, .d_sidebar li, .menu-item, .list-group-item, .nav-item)::before {	content: "\00BB";	position: absolute;	left: 0;	font-weight: bold;	color: #1e73be;	font-size: 24px;	margin-top: -6px;	}	.singlePost h2, .page h2{ margin-top: 26px; }	h2::after { content: ''; display: block; width: 25%; height: 2px; background-color: #1e73be; margin: 16px 0; bottom: 0; left: 0;	}	.singlePost h3, .page h3 { margin-bottom: 30px; border-left: solid 5px #1e73be; padding-left: 